rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Admin check comes purely from Firestore user document or custom claim
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public readable conference collections
    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subthemes/{subthemeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Accounts - Authenticated & Authorization derived purely from Firestore
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow create: if true;
    }

    // Conference Registrations
    match /registrations/{regId} {
      allow read: if isAuthenticated() && (resource.data.email == request.auth.token.email || isAdmin());
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
    }

    // Research Paper Submissions
    match /submissions/{paperId} {
      allow read: if isAuthenticated() && (resource.data.author_email == request.auth.token.email || isAdmin());
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.author_email == request.auth.token.email);
    }

    // Contact messages
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}
